# Spring profile
SPRING_PROFILES_ACTIVE=

# Spring application
SPRING_APPLICATION_NAME="kitty-shop-integration-service"

# Database configuration
SPRING_DATASOURCE_URL="jdbc:postgresql://your-postgres:port/db"
SPRING_DATASOURCE_USERNAME="user"
SPRING_DATASOURCE_PASSWORD="pass"
SPRING_DATASOURCE_DRIVER_CLASS_NAME="org.postgresql.Driver"

# Liquibase configuration
LIQUIBASE_CHANGELOG="classpath:db/changelog/db.changelog-master.yaml"
LIQUIBASE_ENABLED="true"

# Java Persistence API (JPA)
JPA_HIBERNATE_DDL_AUTO="validate"
JPA_SHOW_SQL="true"
JPA_OPEN_IN_VIEW="false"
JPA_PROPERTIES_HIBERNATE_DIALECT="org.hibernate.dialect.PostgreSQLDialect"
JPA_PROPERTIES_JDBC_TIMEZONE="UTC+3"

# JWT configuration
JWT_EXPIRATION="60480000"
JWT_SECRET="your-jwt-secret"